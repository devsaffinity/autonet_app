<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required in the main manifest: debug/ and profile/ declare INTERNET but release does
         not, so a release build has no network access at all — every cached_network_image
         (and every future API call) fails silently. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android 13+ runtime permission for showing any notification. Asked by
         PushService after login; refusing it must not break the app. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- The new-request wizard attaches part photos from the camera or gallery.
         The gallery goes through the system photo picker (image_picker) and
         documents through the system file picker (file_picker), so no
         READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE is declared: Google Play
         makes apps justify those, and this app does not need them. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- required="false" so declaring CAMERA does not make Play hide the app from
         every device without a camera; attaching a photo is optional. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>
    <!-- allowBackup="false": tokens live in shared_preferences this phase, and
         Auto Backup would clone them onto a restored device. Presenting an
         already-rotated refresh token is treated as theft by
         refresh-token.service.ts and revokes the whole family, hard-logging the
         user out everywhere. -->
    <application
        android:label="autonect"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <!-- Names the channel the FCM SDK posts notification-block pushes to when
             the message carries none. The channel itself is created in code by
             FirebasePushGateway; the server also sets this id on every push. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="autonect_default" />
        <!-- Status-bar icon and accent for pushes the FCM SDK shows itself (app in
             the background). Without these it falls back to the coloured launcher
             icon, which Android draws as a plain white square. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_launcher_monochrome" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/ic_launcher_background" />
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher's canLaunchUrl() is package-visibility filtered on
             Android 11+. Without these it returns false for every https and tel
             link on a release build, so "Open in Maps" (service_location_card,
             upcoming_booking_details) and "Call" silently do nothing. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
